diff --git i/hio_win32.c w/hio_win32.c
index e3514fb..193e036 100644
--- i/hio_win32.c
+++ w/hio_win32.c
@@ -26,6 +26,9 @@
 #include "retcodes.h"
 #include <ctype.h>
 #include <string.h>
+#if defined(_BUILD_UNIX)
+#include <unistd.h>
+#endif
 
 
 typedef struct hio_win32_type
@@ -98,7 +101,15 @@ win32_write(hio_t *hio,
 /**************************************************************/
 static int
 win32_flush(/*@unused@*/ hio_t *hio)
-{ /* win32_flush is intentionately blank */
+{
+#if defined(_BUILD_UNIX)
+    /* the device is no longer opened with O_DSYNC, so flush for real */
+    hio_win32_t *hw32 = (hio_win32_t *)hio;
+    if (fsync(hw32->device.desc) != 0) {
+        hw32->error_code = osal_get_last_error_code();
+        return (RET_ERR);
+    }
+#endif
     return (RET_OK);
 }
 
diff --git i/osal_unix.c w/osal_unix.c
index 1298b9f..f9da216 100644
--- i/osal_unix.c
+++ w/osal_unix.c
@@ -95,7 +95,9 @@ int /* OSAL_OK, OSAL_ERR */
 osal_open_device_for_writing(const char *device_name,
                              osal_handle_t *handle)
 {
-    handle->desc = open(device_name, O_RDWR | O_LARGEFILE | O_DSYNC, S_IRUSR | S_IWUSR);
+    handle->desc = open(device_name, O_RDWR | O_LARGEFILE, S_IRUSR | S_IWUSR);
+    /* no O_DSYNC: over NBD it turns every write into a round trip (~0.45 MB/s);
+     * durability comes from explicit hio->flush() calls at the commit points */
     return (handle->desc == -1 ? OSAL_ERR : OSAL_OK);
 }
 
