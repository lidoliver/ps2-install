diff --git i/apa.c w/apa.c
index 7f86251..0bb00f4 100644
--- i/apa.c
+++ w/apa.c
@@ -873,12 +873,16 @@ int apa_commit_ex(hio_t *hio,
                   const apa_toc_t *toc)
 {
     int result = apa_check(toc);
+    if (result == RET_OK) /* everything the TOC refers to must already be on disk */
+        result = hio->flush(hio);
     if (result == RET_OK) {
         result = apa_commit_slice(hio, toc, 0);
         if (result == RET_OK &&
             toc->got_2nd_slice)
             result = apa_commit_slice(hio, toc, 1);
     }
+    if (result == RET_OK)
+        result = hio->flush(hio);
     return (result);
 }
 
