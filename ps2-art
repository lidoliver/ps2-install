#!/usr/bin/env -S python3 -I
"""ps2-art — fetch OPL art for PS2 game IDs into $PS2_GAMES/ART (default ~/Documents/ps2game).

Usage: ps2-art SCUS_971.98 [SLPM_654.95 ...]
       ps2-art --all        (every game ID found in $PS2_GAMES/{DVD,CD})

Source: the OPL Manager art database backup on archive.org (OPLM_ART_2023_11),
read file by file out of the zip, so only what's needed is downloaded.
Falls back to xlenore/ps2-covers for a front cover if the game isn't in it.
Existing files are never overwritten.
"""
import os, re, subprocess, sys, time, urllib.parse, urllib.request

ROOT = os.path.expanduser(os.environ.get("PS2_GAMES") or "~/Documents/ps2game")
ART = os.path.join(ROOT, "ART")
CACHE = os.path.expanduser("~/.cache/ps2-art")
INDEX = os.path.join(CACHE, "oplm_index.html")
ZIP = "https://archive.org/download/OPLM_ART_2023_11/OPLM_ART_2023_11.zip/"
XLENORE = "https://raw.githubusercontent.com/xlenore/ps2-covers/main/covers/default/{}.jpg"
ID_RE = r"S[A-Z]{3}_[0-9]{3}\.[0-9]{2}"

# archive name -> OPL name; anything not listed here is skipped
KINDS = {"COV": "COV", "COV2": "COV2", "ICO": "ICO", "LAB": "LAB", "LGO": "LGO",
         "BG_00": "BG", "SCR_00": "SCR", "SCR_01": "SCR2"}
# OPL Manager's sizes (ICO went 64 -> 128 in OPLM; COV must be 140x200)
SIZES = {"COV": "140x200!", "ICO": "128x128!"}


def fetch(url, dest):
    for attempt in range(3):
        try:
            urllib.request.urlretrieve(url, dest)
            return True
        except Exception as e:
            if getattr(e, "code", None) == 404:
                return False
            time.sleep(2 * (attempt + 1))
    return False


def load_index():
    if not os.path.exists(INDEX) or os.path.getsize(INDEX) < 1_000_000:
        os.makedirs(CACHE, exist_ok=True)
        print("Downloading art index (~20 MB, once)…", flush=True)
        if not fetch(ZIP, INDEX + ".part"):
            sys.exit("Couldn't download the art index from archive.org")
        os.replace(INDEX + ".part", INDEX)
    return open(INDEX, encoding="utf-8", errors="replace").read()


def to_png8(src, dest, kind):
    cmd = ["magick", src, "-strip"]
    if kind in SIZES:
        cmd += ["-resize", SIZES[kind]]
    subprocess.run(cmd + ["-colors", "256", "PNG8:" + dest], check=True)


def art_for(gid, html):
    found = re.findall(r"PS2%2F" + re.escape(gid) + r"%2F" + re.escape(gid) + r"_([A-Z0-9_]+)\.(jpg|png)", html)
    added = []
    for src_kind, ext in sorted(set(found)):
        kind = KINDS.get(src_kind)
        dest = os.path.join(ART, f"{gid}_{kind}.png")
        if not kind or os.path.exists(dest):
            continue
        tmp = os.path.join(CACHE, f"{gid}_{src_kind}.{ext}")
        if fetch(ZIP + urllib.parse.quote(f"PS2/{gid}/{gid}_{src_kind}.{ext}", safe=""), tmp):
            to_png8(tmp, dest, kind)
            os.remove(tmp)
            added.append(kind)
    cov = os.path.join(ART, f"{gid}_COV.png")
    if not os.path.exists(cov):
        tmp = os.path.join(CACHE, f"{gid}_xlenore.jpg")
        if fetch(XLENORE.format(gid.replace("_", "-").replace(".", "")), tmp):
            to_png8(tmp, cov, "COV")
            os.remove(tmp)
            added.append("COV(xlenore)")
    return added


def main():
    args = sys.argv[1:]
    if args == ["--all"]:
        ids = set()
        for d in ("DVD", "CD"):
            p = os.path.join(ROOT, d)
            if os.path.isdir(p):
                ids |= {m.group() for f in os.listdir(p) if (m := re.match(ID_RE, f))}
        args = sorted(ids)
    ids = [a for a in args if re.fullmatch(ID_RE, a)]
    if not ids:
        sys.exit(__doc__)
    os.makedirs(ART, exist_ok=True)
    html = load_index()
    for gid in ids:
        added = art_for(gid, html)
        print(f"{gid}: {'added ' + ' '.join(added) if added else 'nothing new'}", flush=True)


if __name__ == "__main__":
    main()
